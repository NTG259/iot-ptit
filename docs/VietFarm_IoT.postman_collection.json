{
  "info": {
    "name": "VietFarm IoT API",
    "description": "REST API cho hệ thống IoT VietFarm — cảm biến và điều khiển đèn LED.\n\nSau khi login thành công, token sẽ tự động được lưu vào biến {{token}}.\nMọi request tiếp theo dùng Authorization: Bearer {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "deviceCode",
      "value": "LED1",
      "type": "string",
      "description": "Mã thiết bị: LED1 | LED2 | LED3 | WARNING_LED"
    },
    {
      "key": "action",
      "value": "TURN_ON",
      "type": "string",
      "description": "Hành động: TURN_ON | TURN_OFF"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('token', res.data.accessToken);",
                  "    console.log('Token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập. Token trả về sẽ tự động được lưu vào biến {{token}}."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Trường Giang\",\n  \"email\": \"mambong2407@gmail.com\",\n  \"studentId\": \"B23DCCN259\",\n  \"role\": \"Developer\",\n  \"school\": \"PTIT\",\n  \"githubUrl\": \"https://github.com/NTG259\",\n  \"figmaUrl\": null,\n  \"postmanUrl\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "List Devices",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": ["{{baseUrl}}"],
              "path": ["devices"]
            },
            "description": "Trả về 3 đèn LED (LED1/LED2/LED3). `online` phản ánh trạng thái kết nối ESP8266."
          }
        },
        {
          "name": "Get Warning LED",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/devices/warning-led",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "warning-led"]
            },
            "description": "Trả về trạng thái đèn cảnh báo gió. Đèn này tự động bật/tắt khi tốc độ gió vượt ngưỡng 300 m/s."
          }
        },
        {
          "name": "Control Device",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"{{action}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/{{deviceCode}}/control",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "{{deviceCode}}", "control"]
            },
            "description": "Điều khiển một thiết bị. `deviceCode`: LED1/LED2/LED3/WARNING_LED. `action`: TURN_ON/TURN_OFF. Block ~1 giây chờ ESP8266 xác nhận qua MQTT."
          }
        },
        {
          "name": "Control All LEDs",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"{{action}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/control-all",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "control-all"]
            },
            "description": "Bật/tắt cả 3 đèn LED cùng lúc (không bao gồm Warning LED). `action`: TURN_ON/TURN_OFF."
          }
        }
      ]
    },
    {
      "name": "Sensors",
      "item": [
        {
          "name": "Get Temperature",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/temp",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "temp"]
            }
          }
        },
        {
          "name": "Get Humidity",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/humi",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "humi"]
            }
          }
        },
        {
          "name": "Get Light",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/light",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "light"]
            },
            "description": "`lastValue` là % ánh sáng đã quy đổi (100 - round(adc/1280*100))."
          }
        },
        {
          "name": "Get Wind Speed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/wind",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "wind"]
            },
            "description": "Tốc độ gió hiện tại (m/s). Ngưỡng cảnh báo: 300 m/s."
          }
        },
        {
          "name": "Latest Temperature (chart)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/temp/latest?limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "temp", "latest"],
              "query": [{ "key": "limit", "value": "25" }]
            }
          }
        },
        {
          "name": "Latest Humidity (chart)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/humi/latest?limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "humi", "latest"],
              "query": [{ "key": "limit", "value": "25" }]
            }
          }
        },
        {
          "name": "Latest Light (chart)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/light/latest?limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "light", "latest"],
              "query": [{ "key": "limit", "value": "25" }]
            }
          }
        },
        {
          "name": "Latest Wind Speed (chart)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/wind/latest?limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "wind", "latest"],
              "query": [{ "key": "limit", "value": "25" }]
            }
          }
        },
        {
          "name": "Wind Monthly Alerts (chart)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors/wind/monthly-alerts",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "wind", "monthly-alerts"]
            },
            "description": "Số lần tốc độ gió vượt 300 m/s theo ngày, 30 ngày gần nhất. Trả về [{date, count}] đầy đủ 30 phần tử (ngày không có cảnh báo trả về count=0)."
          }
        },
        {
          "name": "Search Sensors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensors?page=1&size=8&newestFirst=true",
              "host": ["{{baseUrl}}"],
              "path": ["sensors"],
              "query": [
                { "key": "search", "value": "", "disabled": true },
                { "key": "types", "value": "TEMPERATURE", "disabled": true, "description": "Lặp lại param để truyền nhiều giá trị: types=TEMPERATURE&types=HUMIDITY" },
                { "key": "status", "value": "ACTIVE", "disabled": true },
                { "key": "updatedSince", "value": "2026-10-20T00:00:00Z", "disabled": true },
                { "key": "newestFirst", "value": "true" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "8" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sensor Data",
      "item": [
        {
          "name": "Search Sensor Readings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sensor-data?page=1&size=10&newestFirst=true",
              "host": ["{{baseUrl}}"],
              "path": ["sensor-data"],
              "query": [
                { "key": "timeSearch", "value": "2026-10-20", "disabled": true, "description": "string — lọc theo ngày/giờ (LIKE prefix trên measured_at_str). Ví dụ: \"2026-10-20\", \"17:30\", \"2026-10-20 17\"." },
                { "key": "valueSearch", "value": "28.5", "disabled": true, "description": "number (string) — khớp đúng giá trị đo. Ví dụ: \"28.5\", \"65\"." },
                { "key": "typeIds", "value": "1", "disabled": true, "description": "integer — ID loại cảm biến, nhiều giá trị ngăn cách bằng dấu phẩy. 1=TEMPERATURE, 2=HUMIDITY, 3=LIGHT, 4=WIND_SPEED. Bỏ trống = không lọc." },
                { "key": "newestFirst", "value": "true", "description": "boolean — true: mới nhất trước (mặc định); false: cũ nhất trước." },
                { "key": "page", "value": "1", "description": "integer — trang hiện tại, bắt đầu từ 1." },
                { "key": "size", "value": "10", "description": "integer — số hàng mỗi trang." }
              ]
            },
            "description": "Lịch sử số đo của mọi cảm biến, có lọc và phân trang. Kết hợp timeSearch + typeIds để lọc đồng thời ngày giờ và loại cảm biến."
          }
        }
      ]
    },
    {
      "name": "Action History",
      "item": [
        {
          "name": "Search Action History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/action-histories?page=1&size=10&newestFirst=true",
              "host": ["{{baseUrl}}"],
              "path": ["action-histories"],
              "query": [
                { "key": "search", "value": "2026-10-20", "disabled": true, "description": "string — lọc theo ngày/giờ (LIKE prefix trên created_at_str). Ví dụ: \"2026-10-20\", \"17:30\", \"2026-10-20 17\"." },
                { "key": "statusIds", "value": "2,3", "disabled": true, "description": "integer — ID trạng thái lệnh, nhiều giá trị ngăn cách bằng dấu phẩy. 1=PENDING, 2=SUCCESS, 3=FAILED. Bỏ trống = không lọc." },
                { "key": "actionIds", "value": "1", "disabled": true, "description": "integer — ID loại hành động, nhiều giá trị ngăn cách bằng dấu phẩy. 1=TURN_ON, 2=TURN_OFF. Bỏ trống = không lọc." },
                { "key": "deviceTypeIds", "value": "1", "disabled": true, "description": "integer — ID loại thiết bị, nhiều giá trị ngăn cách bằng dấu phẩy. 1=SMART_LED, 2=WARNING_LED. Bỏ trống = không lọc." },
                { "key": "newestFirst", "value": "true", "description": "boolean — true: mới nhất trước (mặc định); false: cũ nhất trước." },
                { "key": "page", "value": "1", "description": "integer — trang hiện tại, bắt đầu từ 1." },
                { "key": "size", "value": "10", "description": "integer — số hàng mỗi trang." }
              ]
            },
            "description": "Lịch sử lệnh điều khiển thiết bị, có lọc và phân trang. Kết hợp search + statusIds + actionIds để lọc đồng thời ngày giờ và trạng thái."
          }
        }
      ]
    },
    {
      "name": "Thresholds",
      "item": [
        {
          "name": "Get All Thresholds",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/thresholds",
              "host": ["{{baseUrl}}"],
              "path": ["thresholds"]
            },
            "description": "Trả về ngưỡng cảnh báo của tất cả cảm biến."
          }
        },
        {
          "name": "Update Threshold",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maxValue\": 300\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/thresholds/wind",
              "host": ["{{baseUrl}}"],
              "path": ["thresholds", "wind"]
            },
            "description": "Cập nhật ngưỡng cảnh báo cho một cảm biến. `sensorCode`: temp | humi | light | wind."
          }
        }
      ]
    }
  ]
}
